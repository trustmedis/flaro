{
  "name": "realtime-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @internal/worker dev",
    "build": "pnpm -r build && pnpm --filter @internal/worker db:migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "deploy:worker": "pnpm --filter @internal/worker run deploy"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
